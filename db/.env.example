# docker-compose 用的环境变量模板。复制一份改名 .env（已在 .gitignore，不会被提交），
# 填真实值再 docker compose up。

# 容器内 MySQL 的 root 密码，跟你本机 MySQL84 服务的密码是两码事，随便设一个新的就行
# （这个容器是给 docker-compose 这套独立用的，不是你本机那个 3306 的 MySQL84）
MYSQL_ROOT_PASSWORD=changeme

# JWT 签名密钥，>= 64 个字符，生成：openssl rand -hex 64
JWT_TOKEN_SIGN_KEY=

# 挂了真实 HTTPS 反代之后再打开（jwt.cookie.secure=true 要求 HTTPS，见 springboot3-blog/Dockerfile
# 里的说明）——docker-compose 这套本地跑的是纯 HTTP，先留空
# SPRING_PROFILES_ACTIVE=prod
